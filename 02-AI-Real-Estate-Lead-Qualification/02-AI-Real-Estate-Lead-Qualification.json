{
  "name": "My workflow 2",
  "nodes": [
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const data = item.json;\n\n  // 1. Basic text cleaning\n  const name = String(data[\"Name\"] || \"\").trim();\n  const location = String(data[\"Location\"] || \"\").trim();\n  const propertyType = String(data[\"Property Type\"] || \"\").trim();\n  const bhk = String(data[\"BHK\"] || \"\").trim();\n  const timeline = String(data[\"TimeLine\"] || \"\").trim();\n\n  // 2. Phone number cleaning\n  let phone = String(data[\"Phone Number\"] || \"\")\n    .replace(/\\D/g, \"\");\n\n  // India country code handling\n  if (phone.length === 10) {\n    phone = \"+91\" + phone;\n  } else if (phone.startsWith(\"91\") && phone.length === 12) {\n    phone = \"+\" + phone;\n  }\n\n  // 3. Email cleaning\n  const email = String(data[\"Email\"] || \"\")\n    .trim()\n    .toLowerCase();\n\n  // 4. Budget cleaning\n  const budgetText = String(data[\"Budget\"] || \"\")\n    .trim()\n    .toLowerCase();\n\n  const budgetNumber = parseFloat(\n    budgetText.replace(/[^0-9.]/g, \"\")\n  ) || 0;\n\n  // 5. BHK number निकालना\n  const bhkNumber = parseInt(bhk.replace(/\\D/g, \"\")) || 0;\n\n  // 6. Final cleaned data\n  return {\n    json: {\n      name: name,\n      phone: phone,\n      email: email,\n      location: location,\n      budget: budgetText,\n      budgetNumber: budgetNumber,\n      propertyType: propertyType,\n      bhk: bhk,\n      bhkNumber: bhkNumber,\n      timeline: timeline,\n\n      // extra useful fields\n      leadSource: \"Website Form\",\n      cleaned: true,\n      cleanedAt: new Date().toISOString()\n    }\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
